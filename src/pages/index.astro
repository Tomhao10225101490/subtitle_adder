---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorApp from '../components/Editor/EditorApp.astro';
---
<BaseLayout>
  <header class="border-b border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
      <div class="flex items-center gap-3 min-w-0">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg brand-gradient text-white text-sm font-bold">字</span>
        <div class="min-w-0">
          <p class="text-white font-semibold leading-tight">字幕加加</p>
          <p class="text-xs text-slate-400 truncate">本地识别 · 可编辑 · 烧录成片</p>
        </div>
      </div>
      <p class="hidden sm:block text-xs text-slate-500">视频不离开这台电脑 · 推荐 Chrome / Edge</p>
    </div>
  </header>
  <main>
    <EditorApp />
  </main>
</BaseLayout>
